[Unit]
Description=cgslim-agent livello 1: controllo flotta a regole
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openclaw
WorkingDirectory=/opt/cgslim-agent
# note da Telegram: prima del check (una sola chiamata, veloce) e con '-': un suo errore
# non ferma il controllo, e un check fallito non ferma le note
ExecStart=-/opt/cgslim-agent/venv/bin/python -m agent.cli inbox
ExecStart=/opt/cgslim-agent/venv/bin/python -m agent.cli check
TimeoutStartSec=3min
